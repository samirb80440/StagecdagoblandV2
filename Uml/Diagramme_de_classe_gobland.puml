@startuml BaseDeDonnéesEtUtilisation

' Enum pour status Entity
enum Status {
  ALIVE
  DEAD
  SLEEPING
}

' Classes existantes
class Player {
  +id : UUID
  +email : String
  +maxcharacter : int
  +name : String
  +imageprofil : String
}

class Mail {
  +id : UUID
  +title : String
  +text : String
  +datesend : DateTime
  +sender : UUID
}

class Entity {
  +id : UUID
  +name : String
  +gender : int
  +description : String
  +imageavatar : String
  +datecreation : DateTime
  +datelastdeath : DateTime
  +turnduration : Time
  +nextturn : DateTime
  +actionpoint : int
  +hitpoints : int
  +hitpointsmax : int
  +hunger : int
  +kills : int
  +pvpkills : int
  +turnattckdomage : int
  +deathcounts : int
  +dogde : int
  +attack : int
  +damage : int
  +regeneration : int
  +perception : int
  +active : boolean
  +psychicresit : int
  +psychicmast : int
  +physicalresit : int
  +physicalmast : int
  +magicrest : int
  +magicmast : int
  +obscurerest : int
  +obscuremast : int
  +socialrest : int
  +socialmast : int
  +technologyrest : int
  +technologymast : int
  +x : int
  +y : int
  +n : int
  +pvp : boolean
  +nbapmove : int
  +nbapattack : int
  +nbattack : int
  +update_ : DateTime
  +saveuniquemob : boolean
  +rangex : int
  +rangey : int
  +size : int
  +armphy : int
  +armmag : int
  +upgradeturnduration : int
  +upgradeattack : int
  +upgradedodge : int
  +upgradeperception : int
  +upgradedamege : int
  +upgradehitpoints : int
  +upgraderegeneration : int
  +upgradearmphy : int
  +upgradearmmag : int
  +status : Status
  +popularity : int
  +fame : int
  +reputation : int
  +levelseeinvisible : String
  +soul : String
}

' Nouvelles classes liées au cas d'utilisation

class Admin {
  +id : UUID
  +name : String
  +email : String
  +role : String
}

class Quest {
  +id : UUID
  +title : String
  +description : String
  +status : String
}

class QuestStep {
  +id : UUID
  +description : String
  +order : int
}

class QuestReward {
  +id : UUID
  +description : String
  +rewardType : String
  +value : int
}

class Monster {
  +id : UUID
  +name : String
  +level : int
  +description : String
}

class Feature {
  +id : UUID
  +name : String
  +description : String
  +status : String
}

class Species {
  +id : UUID
  +name : String
  +description : String
}

class GameObject {
  +id : UUID
  +name : String
  +description : String
}

class ObjectType {
  +id : UUID
  +name : String
  +description : String
}

class GameWorld {
  +id : UUID
  +name : String
  +description : String
}

class GameWorldType {
  +id : UUID
  +name : String
  +description : String
}

' Relations existantes
Player "1" <-- "0..*" Mail : sender
Entity "0..1" --> "0..*" Entity : master

' Relations nouvelles

Admin "1" <-- "0..*" Quest : creates
Quest "1" --> "0..*" QuestStep : includes
Quest "1" --> "0..*" QuestReward : grants

Admin "1" <-- "0..*" Monster : manages
Admin "1" <-- "0..*" Feature : tests
Admin "1" <-- "0..*" Species : creates
Admin "1" <-- "0..*" GameObject : creates
Admin "1" <-- "0..*" ObjectType : creates
Admin "1" <-- "0..*" GameWorld : creates
Admin "1" <-- "0..*" GameWorldType : creates

Player "0..*" --> "0..*" Quest : participates

@enduml
