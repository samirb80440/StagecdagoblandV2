@startuml Sequence_gobland
actor Player
actor Admin

participant "UI" as UI
participant "Système" as System
participant "Base de données" as DB

== Player ==

Player -> UI : S'inscrire
UI -> System : Créer compte
System -> DB : INSERT INTO players
DB --> System : OK
System --> UI : Confirmation

Player -> UI : Faire une action
UI -> System : Traiter action
alt Action réussie
  System -> DB : UPDATE état joueur
  System --> UI : Message succès
else Action échouée
  System --> UI : Message échec
end

== Admin ==

Admin -> UI : Créer une quête
UI -> System : Valider et créer quête
alt Erreur validation
  System --> UI : Message erreur validation
else
  System -> DB : INSERT INTO quest
  DB --> System : OK
  System --> UI : Quête créée

  Admin -> UI : Ajouter une étape
  UI -> System : Créer queststep
  alt Erreur ajout étape
    System --> UI : Erreur étape
  else
    System -> DB : INSERT INTO queststep
    DB --> System : OK
    System --> UI : Étape ajoutée
  end

  Admin -> UI : Ajouter une récompense
  UI -> System : Créer reward
  alt Erreur ajout récompense
    System --> UI : Erreur reward
  else
    System -> DB : INSERT INTO reward
    DB --> System : OK
    System --> UI : Récompense ajoutée
  end
end

Admin -> UI : Ajouter un monstre
UI -> System : Créer entité monstre
System -> DB : INSERT INTO entity (monstre)
DB --> System : OK / erreur
System --> UI : Résultat

Admin -> UI : Créer une espèce
UI -> System : Créer dans table specie
System -> DB : INSERT INTO specie
alt Erreur
  System --> UI : Message erreur
else
  Admin -> UI : Tester espèce
  UI -> System : Simulation
  System --> UI : Résultat test
end

Admin -> UI : Créer un objet
UI -> System : Créer objet
System -> DB : INSERT INTO object
alt Erreur
  System --> UI : Message erreur
else
  Admin -> UI : Tester objet
  UI -> System : Simulation
  System --> UI : Résultat test
end

Admin -> UI : Créer un objecttype
UI -> System : Créer type
System -> DB : INSERT INTO objecttype
alt Erreur
  System --> UI : Message erreur
else
  Admin -> UI : Tester objecttype
  UI -> System : Simulation
  System --> UI : Résultat test
end

Admin -> UI : Créer un gameworld
UI -> System : Créer instance
System -> DB : INSERT INTO instance
alt Erreur
  System --> UI : Message erreur
else
  Admin -> UI : Tester gameworld
  UI -> System : Simulation
  System --> UI : Résultat test
end

Admin -> UI : Créer un gameworldtype
UI -> System : Créer instancetype
System -> DB : INSERT INTO instancetype
alt Erreur
  System --> UI : Message erreur
else
  Admin -> UI : Tester gameworldtype
  UI -> System : Simulation
  System --> UI : Résultat test
end

@enduml
