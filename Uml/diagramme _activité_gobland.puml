@startuml Activité_gobland

start

partition "Player" {
  :Inscription;
  :Parcourir les rubriques;
  :Faire une action;
  if (Action réussie ?) then (Oui)
    :Afficher message action;
  else
    :Afficher message échec;
  endif
}

partition "Admin" {

  :Consulter rubrique;
  if (Erreur chargement rubrique ?) then (Oui)
    :Afficher erreur rubrique;
  endif

  :Consulter les quêtes;
  if (Erreur chargement quêtes ?) then (Oui)
    :Afficher erreur quêtes;
  endif

  :Créer une quête;
  if (Erreur validation quête ?) then (Oui)
    :Afficher erreur validation;
  else
    :Ajouter une quête;
    if (Erreur ajout quête ?) then (Oui)
      :Afficher erreur ajout quête;
    else
      :Ajouter une étape de quête;
      if (Erreur ajout étape ?) then (Oui)
        :Afficher erreur ajout étape;
      endif

      :Ajouter une récompense de quête;
      if (Erreur ajout récompense ?) then (Oui)
        :Afficher erreur ajout récompense;
      endif
    endif
  endif

  :Ajouter un monstre;
  if (Erreur ajout monstre ?) then (Oui)
    :Afficher erreur ajout monstre;
  endif

  :Consulter joueur;
  if (Erreur consultation joueur ?) then (Oui)
    :Afficher erreur joueur;
  endif

  :Consulter monstre;
  if (Erreur consultation monstre ?) then (Oui)
    :Afficher erreur monstre;
  endif

  :Tester une fonctionnalité;
  if (Fonctionnalité fonctionne ?) then (Oui)
    :Afficher OK;
  else
    :Patcher et régler bug;
    if (Bug corrigé ?) then (Oui)
      :Afficher correctif réussi;
    else
      :Afficher échec correction;
    endif
  endif

  :Ajouter une fonctionnalité;
  if (Fonctionnalité marche ?) then (Oui)
    :Afficher ajout réussi;
  else
    :Vérifie si c’est un bug;
    if (Bug trouvé ?) then (Oui)
      :Résout bug;
      :Test bug;
      :Afficher jeu fonctionnel;
    else
      :Résout problème de fonctionnalité;
      :Retenter ajout;
    endif
  endif

  :Créer une espèce;
  if (Erreur création espèce ?) then (Oui)
    :Afficher erreur création espèce;
  else
    :Tester une espèce;
    if (Espèce fonctionnelle ?) then (Oui)
      :Afficher succès espèce;
    else
      :Corriger espèce;
    endif
  endif

  :Créer un objet;
  if (Erreur création objet ?) then (Oui)
    :Afficher erreur création objet;
  else
    :Tester un objet;
    if (Objet fonctionnel ?) then (Oui)
      :Afficher succès objet;
    else
      :Corriger objet;
    endif
  endif

  :Créer un objecttype;
  if (Erreur création objecttype ?) then (Oui)
    :Afficher erreur création objecttype;
  else
    :Tester un objecttype;
    if (Objecttype fonctionnel ?) then (Oui)
      :Afficher succès objecttype;
    else
      :Corriger objecttype;
    endif
  endif

  :Créer un gameworld;
  if (Erreur création gameworld ?) then (Oui)
    :Afficher erreur création gameworld;
  else
    :Tester un gameworld;
    if (Gameworld fonctionnel ?) then (Oui)
      :Afficher succès gameworld;
    else
      :Corriger gameworld;
    endif
  endif

  :Créer un gameworldtype;
  if (Erreur création gameworldtype ?) then (Oui)
    :Afficher erreur création gameworldtype;
  else
    :Tester un gameworldtype;
    if (Gameworldtype fonctionnel ?) then (Oui)
      :Afficher succès gameworldtype;
    else
      :Corriger gameworldtype;
    endif
  endif
}

stop

@enduml
